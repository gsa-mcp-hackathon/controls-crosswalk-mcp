# Virtual environments
.venv/
venv/

# Environment variables (keep .env.example, never commit .env)
.env
deploy/**/.env
deploy/**/eval.env

# Deploy kit generated artifacts
deploy/ibm/local-mcp-toolkit/_stage/
deploy/ibm/local-mcp-toolkit/_toolkit.generated.yaml
deploy/**/eval-results/


# IBM Bob IDE directory (skills and MCP tool definition)
.bob/


# Fetched source data. Rebuild with: uv run python -m crosswalk_mcp.snapshot fetch
# The manifest is committed; it records the hash of every file the build used.
data/raw/*
!data/raw/manifest.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ruff
.ruff_cache/

# IDE / editor
.vscode/
.idea/
.zed/
*.swp

# Ignore reference files for Databricks agnet 
eval/databricks/agent_server/agent.py
eval/databricks/agent_server/utils.py 

