# ─── MCP Transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop / Claude Code / Zed)
# "streamable-http" — remote HTTP server (containers, cloud deploys)
#
# On a cloud host (IBM Code Engine, Databricks Apps) you usually leave this as
# stdio: app.py automatically switches to HTTP when the platform injects a port
# (DATABRICKS_APP_PORT or PORT).
MCP_TRANSPORT=stdio

# ─── HTTP Server (only used when running over HTTP) ───────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Data files ───────────────────────────────────────────────────────────────
# Root for fetched sources (data/raw) and the built store. No API keys are
# needed; every source is public.
DATA_DIR=data

# ─── Evaluation harness only (eval/phoenix) ───────────────────────────────────
# The server itself needs no credentials. These are read only by the Phoenix
# evaluation harness, which drives an agent and two judges through one model
# provider. Never commit the filled-in .env.

# Which provider to use: openai (the default) or watsonx.
MODEL_PROVIDER=openai

# Model ids, both required. The agent model must support tool calling. Keep
# the judge different from the agent. These are examples for OpenAI.
# https://platform.openai.com/docs/models
AGENT_MODEL=gpt-5
JUDGE_MODEL=gpt-5-mini
# Examples for watsonx.ai. eval/phoenix/README.md shows how to list the
# models your region serves.
# AGENT_MODEL=meta-llama/llama-3-3-70b-instruct
# JUDGE_MODEL=mistral-large-2512

# OpenAI settings, used when MODEL_PROVIDER=openai.
# https://platform.openai.com/docs/api-reference/authentication
OPENAI_API_KEY=
# Only for an OpenAI-compatible endpoint other than api.openai.com. Leave it
# commented out to use OpenAI itself.
# OPENAI_BASE_URL=

# IBM watsonx.ai settings, used when MODEL_PROVIDER=watsonx. The URL is the
# regional endpoint and must match the project's region. The key is an IBM
# Cloud API key. The project id is under the project's Manage tab, General.
# https://dataplatform.cloud.ibm.com/docs/content/wsj/analyze-data/fm-credentials.html
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# Judges run at temperature 0 where the model allows it. Reasoning models
# only accept their default, and the harness leaves the setting out for them.
# JUDGE_TEMPERATURE=0
# Where the harness sends traces. Defaults suit `uv run arize-phoenix serve`.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
